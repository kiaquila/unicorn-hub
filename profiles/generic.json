{
  "id": "generic",
  "description": "Fallback profile for repositories that need manual command adaptation.",
  "docsDir": "docs_project",
  "specsDir": "specs",
  "productPaths": ["src/", "app/"],
  "commands": {
    "preflight": "pnpm run preflight"
  },
  "requiredChecks": ["baseline-checks", "guard", "osv-scan", "AI Review"],
  "dependabotUpdates": [
    {
      "packageEcosystem": "github-actions",
      "directory": "/"
    },
    {
      "packageEcosystem": "npm",
      "directory": "/"
    }
  ],
  "deploy": {
    "type": "project-specific"
  }
}
