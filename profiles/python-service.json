{
  "id": "python-service",
  "description": "Python service, worker, API, or scheduled job.",
  "docsDir": "docs_project",
  "specsDir": "specs",
  "productPaths": ["src/", "app/", "service/", "scripts/", "pyproject.toml", "requirements.txt", "requirements-dev.txt"],
  "packageManager": "uv",
  "pythonVersion": "3.12",
  "commands": {
    "install": "uv lock --check && uv sync --locked",
    "test": "uv run pytest",
    "preflight": "uv lock --check && uv run pytest"
  },
  "dependencyPolicy": {
    "python": {
      "enabled": true,
      "requirementsLockFile": "requirements.lock"
    }
  },
  "requiredChecks": ["baseline-checks", "guard", "osv-scan", "AI Review"],
  "dependabotUpdates": [
    {
      "packageEcosystem": "github-actions",
      "directory": "/"
    },
    {
      "packageEcosystem": "pip",
      "directory": "/"
    }
  ],
  "deploy": {
    "type": "project-specific",
    "production": "merge_to_main_or_release_workflow"
  }
}
