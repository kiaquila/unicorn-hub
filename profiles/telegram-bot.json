{
  "id": "telegram-bot",
  "description": "Bot application with handler-first architecture and isolated external ports.",
  "docsDir": "docs_project",
  "specsDir": "specs",
  "productPaths": ["src/", "bot/", "handlers/", "adapters/", "pyproject.toml", "package.json"],
  "architecture": {
    "rule": "Each command or conversation flow should be implemented as an isolated handler with injected ports for external services."
  },
  "packageManager": "uv",
  "pythonVersion": "3.12",
  "commands": {
    "install": "uv lock --check && uv sync --locked",
    "test": "uv run pytest",
    "preflight": "uv lock --check && uv run pytest"
  },
  "dependencyPolicy": {
    "python": {
      "enabled": true,
      "requirementsLockFile": "requirements.lock"
    }
  },
  "requiredChecks": ["baseline-checks", "guard", "AI Review"],
  "deploy": {
    "type": "project-specific",
    "production": "merge_to_main_or_release_workflow"
  }
}
