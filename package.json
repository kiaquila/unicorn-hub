{
  "name": "unicorn-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Portable multi-agent development blueprint.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.16"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap-repo.mjs",
    "agent:set": "node scripts/set-implementation-agent.mjs",
    "check:feature-memory": "node scripts/check-feature-memory.mjs",
    "check:repo": "node scripts/check-repo-baseline.mjs",
    "check:syntax": "for file in scripts/*.mjs tests/*.mjs; do node --check \"$file\"; done",
    "sanitize": "node scripts/sanitize-blueprint.mjs",
    "test": "node --test tests/*.test.mjs",
    "preflight": "node scripts/check-feature-memory.mjs --worktree && pnpm run check:repo && pnpm run check:syntax && pnpm run sanitize && pnpm run test"
  }
}
