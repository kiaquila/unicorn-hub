  "requiredChecks": ["baseline-checks", "guard", "AI Review"],
  "reviewAgents": ["codex", "claude", "gemini"],
  "trustedReviewLogins": [],
  "trustedReviewLoginsByAgent": {},
  "defaultImplementationAgent": "claude",
